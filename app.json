{
  "expo": {
    "name": "basic_crm",
    "slug": "basic_crm",
    "version": "1.0.0",
    "scheme": "basiccrm",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "android": {
      "package": "com.basiccrm.app",
      "adaptiveIcon": {
        // "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": ["android.permission.INTERNET"]
    },

    "ios": {
      "bundleIdentifier": "com.basiccrm.app",
      "supportsTablet": true
    },

    "web": {
      // "favicon": "./assets/favicon.png"
    },

    "experiments": {
      "typedRoutes": true
    }
  }
}
